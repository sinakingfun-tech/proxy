{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "proxy",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "309d6615-b864-4a1a-89ce-bf4f83dba6c4","database_name": "nova" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "413e421d94e14804bc52d1f2ec423389" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
